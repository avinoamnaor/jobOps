# Copy this file to `.env` and adjust if needed.
# `.env` is gitignored. `.env.example` is committed and documents every variable
# the application understands.

# --- Application ---------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#   postgresql -> the database
#   +psycopg   -> the Python driver SQLAlchemy should use (psycopg 3)
# The credentials must match the `environment:` block in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops

# Used from Phase 1 onwards so tests never touch your real data.
TEST_DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops_test

# Set to true to echo every SQL statement to the console. Useful while learning.
SQL_ECHO=false

# --- File storage --------------------------------------------------------
# Relative paths are resolved against the repository root, never the current
# working directory. Used from Phase 2 onwards.
DOCUMENTS_ROOT=data/documents

# Filename presented when downloading a CV "for submission" — a clean,
# employer-facing name. Set this to your own (e.g. "CV - Jane Doe.pdf"). The
# stored file is never renamed; only the download filename changes.
SUBMISSION_CV_FILENAME=CV - Applicant.pdf

# Local root where a per-application folder is prepared on creation, holding a
# convenience copy of the submitted CV. Prefer a folder outside the repository,
# e.g. C:\Users\<you>\Documents\Job Applications. Relative paths resolve against
# the repo root; absolute paths point anywhere on disk.
APPLICATION_EXPORT_ROOT=application-exports

# --- Gmail (Phase 6.1: read-only sync foundation) -------------------------
# Path to the OAuth client file downloaded from Google Cloud Console (Desktop
# app type). Never commit this file. See backend/scripts/gmail_authorize.py.
GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
# Where the authorized token (produced once by gmail_authorize.py) is stored.
# Also never committed — both live under the gitignored secrets/ folder.
GMAIL_TOKEN_PATH=secrets/gmail_token.json
# How many days back each sync looks.
GMAIL_SYNC_WINDOW_DAYS=30
# Safety cap on messages fetched per sync call.
GMAIL_MAX_MESSAGES_PER_SYNC=200

# --- Email classification (Phase 6.2A-1) ---------------------------------
# Which provider classifies emails: openai | anthropic
# The classifier itself is provider-neutral, so this is the only change needed
# to switch. Only the selected provider's key is required.
EMAIL_CLASSIFIER_PROVIDER=openai

# API keys. Leave these EMPTY here and set the real values only in your local
# .env, which is gitignored. Never commit a key. Without the selected
# provider's key the classifier reports that it is not configured; nothing
# else is affected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which model classifies emails. Leave EMPTY to use the selected provider's
# default (openai -> gpt-5.6-luna, anthropic -> claude-opus-5).
#
# Deliberately unset by default: a pinned value here would be sent to whichever
# provider is selected, so flipping EMAIL_CLASSIFIER_PROVIDER with a model name
# still set would ask one provider for the other's model. Set it explicitly
# only to override — e.g. to compare claude-sonnet-5 or claude-haiku-4-5.
EMAIL_CLASSIFIER_MODEL=

# Ceiling on one reply. Required by Anthropic's Messages API; unused by the
# OpenAI path. Generous on purpose: where thinking is on by default, reasoning
# tokens come out of this same budget, and too small a cap truncates the answer.
EMAIL_CLASSIFIER_MAX_OUTPUT_TOKENS=4096

# Cost bound on one request. Recruitment emails are far shorter than this; the
# cap is for the occasional long quoted thread.
EMAIL_CLASSIFIER_MAX_BODY_CHARS=8000

# Seconds before a classification request is abandoned.
EMAIL_CLASSIFIER_TIMEOUT_SECONDS=60

# --- Frontend ------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# 5173 is the Vite dev-server default (Phase 3).
CORS_ORIGINS=http://localhost:5173
