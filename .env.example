# Copy this file to `.env` and adjust if needed.
# `.env` is gitignored. `.env.example` is committed and documents every variable
# the application understands.

# --- Application ---------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#   postgresql -> the database
#   +psycopg   -> the Python driver SQLAlchemy should use (psycopg 3)
# The credentials must match the `environment:` block in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops

# Used from Phase 1 onwards so tests never touch your real data.
TEST_DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops_test

# Set to true to echo every SQL statement to the console. Useful while learning.
SQL_ECHO=false

# --- File storage --------------------------------------------------------
# Relative paths are resolved against the repository root, never the current
# working directory. Used from Phase 2 onwards.
DOCUMENTS_ROOT=data/documents

# --- Frontend ------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# 5173 is the Vite dev-server default (Phase 3).
CORS_ORIGINS=http://localhost:5173
