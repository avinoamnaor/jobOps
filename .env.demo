# Demo / presentation configuration — NOT your real data.
#
# This file is loaded ONLY when you explicitly set, in a PowerShell session:
#     $env:JOBOPS_ENV_FILE = ".env.demo"
# Otherwise the app loads `.env` and uses your real local database and documents.
#
# It points at a SEPARATE database (jobops_demo) and a SEPARATE documents folder
# (demo-data/documents), so nothing here can touch your real `jobops` database
# or your real files under `data/documents`.
#
# The credentials below are the same non-secret localhost values as .env.example.

APP_ENV=demo
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops_demo
# Kept for completeness; the demo workflow does not run the test suite.
TEST_DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops_test
SQL_ECHO=false

# A separate documents folder. Your real CVs under data/documents are never read.
DOCUMENTS_ROOT=demo-data/documents

CORS_ORIGINS=http://localhost:5173
